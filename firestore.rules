rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function connected(a, b) {
      return (exists(/databases/$(database)/documents/connections/$(a + "_" + b)) &&
              get(/databases/$(database)/documents/connections/$(a + "_" + b)).data.status == "active")
          || (exists(/databases/$(database)/documents/connections/$(b + "_" + a)) &&
              get(/databases/$(database)/documents/connections/$(b + "_" + a)).data.status == "active");
    }

    match /users/{uid} {
      allow read: if request.auth != null &&
                     (request.auth.uid == uid || connected(request.auth.uid, uid));
      allow write: if false;
    }

    match /locations/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        (connected(request.auth.uid, uid) &&
         (get(/databases/$(database)/documents/users/$(uid)).data.trackMe == true ||
          get(/databases/$(database)/documents/users/$(uid)).data.unsafe == true)));
      allow write: if false;
    }

    match /connections/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow write: if false;
    }

    match /secrets/{id}     { allow read, write: if false; }
    match /identifiers/{id} { allow read, write: if false; }
    match /attempts/{id}    { allow read, write: if false; }
  }
}
